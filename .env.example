# Copy this file to `.env` in this folder if you want SMTP/API overrides.
# Never commit `.env`. User profile, resume, and job history live in ~/.applyflow
# and are not part of this repository.

# Optional SMTP for mailto / email-apply jobs
APPLYFLOW_SMTP_HOST=smtp.example.com
APPLYFLOW_SMTP_PORT=587
APPLYFLOW_SMTP_USER=you@example.com
APPLYFLOW_SMTP_PASSWORD=
APPLYFLOW_SMTP_FROM=you@example.com

# Optional USAJobs (register at https://developer.usajobs.gov)
APPLYFLOW_USAJOBS_KEY=
APPLYFLOW_USAJOBS_EMAIL=

# Optional Adzuna (https://developer.adzuna.com)
APPLYFLOW_ADZUNA_APP_ID=
APPLYFLOW_ADZUNA_APP_KEY=
APPLYFLOW_ADZUNA_COUNTRY=us
